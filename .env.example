# Exemplo de env vars. Copie para .env e preencha.
# NUNCA commite .env com valores reais.

# ---- API (artifacts/api-server) ----
# Supabase: Project Settings → Database → Connection string → URI (Transaction pooler, porta 6543)
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Lista separada por vírgula das origens permitidas. Vazio = libera geral (só dev).
CORS_ORIGIN=https://seu-dashboard.onrender.com

# Render injeta PORT automaticamente. Em dev cai em 3000.
# PORT=3000

# ---- Dashboard (artifacts/cve-dashboard) — build-time ----
# URL pública da API. Deixe vazio em dev pra usar o proxy do vite.
VITE_API_URL=https://sua-api.onrender.com
